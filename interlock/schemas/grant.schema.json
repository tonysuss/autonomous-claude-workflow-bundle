{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.interlock.dev/v1/grant.schema.json",
  "title": "Grant",
  "description": "Authority given by the operator. Written only by the operator path. No grant can cover the irreversible class.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "principal", "task_scope", "action_classes", "tools", "landing_authority", "origin", "created_at"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "principal": { "type": "string", "minLength": 1 },
    "task_scope": {
      "description": "Task ids, or [\"*\"] for every task.",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "action_classes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/grantable_action_class" }
    },
    "tools": { "$ref": "common.schema.json#/$defs/tool_policy" },
    "landing_authority": { "$ref": "common.schema.json#/$defs/landing_authority" },
    "origin": { "type": "string", "description": "Where the grant came from, for example the operator's own words." },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "expires_at": {
      "oneOf": [{ "$ref": "common.schema.json#/$defs/timestamp" }, { "type": "null" }]
    },
    "revoked_at": {
      "oneOf": [{ "$ref": "common.schema.json#/$defs/timestamp" }, { "type": "null" }]
    }
  }
}
