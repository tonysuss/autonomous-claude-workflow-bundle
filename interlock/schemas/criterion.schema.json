{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.interlock.dev/v0/criterion.schema.json",
  "title": "Criterion",
  "description": "One acceptance criterion. Lives on its task; changing it changes the task's policy digest, which invalidates existing evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "statement", "min_strength", "producer"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "statement": { "type": "string", "minLength": 1 },
    "check": { "type": ["string", "null"], "description": "Reference to the check that tests this criterion, such as a script path." },
    "check_version": { "type": "string", "minLength": 1, "default": "1" },
    "min_strength": { "$ref": "common.schema.json#/$defs/min_strength" },
    "producer": { "$ref": "common.schema.json#/$defs/producer" }
  }
}
