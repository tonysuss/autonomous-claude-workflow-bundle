umber) * UNITS[ch]", "+            total += int(number) * UNITS[ch]", "             number = \"\"", "         else:", "             raise ValueError(f\"unknown unit {ch!r} in {text!r}\")"]}], "userModified": false, "replaceAll": false, "gitDiff": {"filename": "durations.py", "status": "modified", "additions": 1, "deletions": 1, "changes": 2, "patch": "@@ -13,7 +13,7 @@ def parse_duration(text):\n         elif ch in UNITS:\n             if not number:\n                 raise ValueError(f\"missing number before {ch!r} in {text!r}\")\n-            total = int(number) * UNITS[ch]\n+            total += int(number) * UNITS[ch]\n             number = \"\"\n         else:\n             raise ValueError(f\"unknown unit {ch!r} in {text!r}\")", "repository": null}}}
