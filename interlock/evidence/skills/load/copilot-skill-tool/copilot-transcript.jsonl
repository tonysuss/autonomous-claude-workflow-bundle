{"data": {"skills": [{"commandName": "interlock-design", "description": "Compare two or more whole designs for an interlock task before implementing, when the change crosses function boundaries and both the uncertainty and the cost of a wrong shape are high. Started by a person; skip it for small or obvious changes.", "enabled": true, "name": "interlock-design", "path": "/tmp/.tmp5i4MZr/.github/skills/interlock-design/SKILL.md", "source": "project", "userInvocable": true}, {"commandName": "interlock-implement", "description": "Make the smallest change that meets an interlock task's criteria, in the isolated worktree interlock opens for the attempt: reproduce first for a bug fix, build from a named data shape for a feature, pin behavior first for a refactor.", "enabled": true, "name": "interlock-implement", "path": "/tmp/.tmp5i4MZr/.github/skills/interlock-implement/SKILL.md", "source": "project", "userInvocable": true}, {"commandName": "interlock-investigate", "description": "Answer how something works or why it was built that way, with file and line evidence and the history behind it, before anything changes. Use for an interlock investigation task, and to ground a bug fix, feature or refactor.", "enabled": true, "name": "interlock-investigate", "path": "/tmp/.tmp5i4MZr/.github/skills/interlock-investigate/SKILL.md", "source": "project", "userInvocable": true}, {"commandName": "interlock-review", "description": "Adversarially review a submitted interlock result before it is verified: findings with evidence, a lead judgment on each (act on, consider, noted, dismissed), dismissals kept, and the act-on findings handed to the verifier.", "enabled": true, "name": "interlock-review", "path": "/tmp/.tmp5i4MZr/.github/skills/interlock-review/SKILL.md", "source": "project", "userInvocable": true}, {"commandName": "interlock-route", "description": "Start here for any request to investigate, fix, build or restructure code in a repository that uses interlock. Picks the workflow (investigation, bug fix, feature, refactor), writes its acceptance criteria, and creates the interlock task.", "enabled": true, "name": "interlock-route", "path": "/tmp/.tmp5i4MZr/.github/skills/interlock-route/SKILL.md", "source": "project", "userInvocable": true}, {"commandName": "interlock-verify", "description": "Hand an interlock task that awaits verification to the independent verifier agent, then let interlock decide: verified, sent back for rework, or still waiting. Use after a result is submitted, and never verify your own work.", "enabled": true, "name": "interlock-verify", "path": "/tmp/.tmp5i4MZr/.github/skills/interlock-verify/SKILL.md", "source": "project", "userInvocable": true}, {"commandName": "customize-cloud-agent", "description": "Skill for customizing the Copilot cloud agent (formerly known as Copilot coding agent) environment, including copilot-setup-steps.yml configuration, preinstalling tools and dependencies, runners, and settings. Use when the user mentions copilot-setup-steps, copilot setup steps, or wants to configure the cloud agent environment.", "enabled": true, "name": "customize-cloud-agent", "path": "/root/.cache/copilot/pkg/linux-x64/1.0.91/builtin/customize-cloud-agent/SKILL.md", "source": "builtin", "userInvocable": false}, {"commandName": "github-pr-media", "description": "Upload an image or video to GitHub's user attachments API and embed it in a pull request description or comment. Use when asked to add screenshots, diagrams, recordings, or other media to a PR or GitHub comment.", "enabled": true, "name": "github-pr-media", "path": "/root/.cache/copilot/pkg/linux-x64/1.0.91/builtin/github-pr-media/SKILL.md", "source": "builtin", "userInvocable": false}]}, "ephemeral": true, "id": "64d9b75a-05e7-4829-aa2c-009e4a4855f8", "parentId": "8b1264ff-b5fb-486a-ac40-1854106c5e8e", "timestamp": "2026-10-06T01:59:02.053Z", "type": "session.skills_loaded"}
